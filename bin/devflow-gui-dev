#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export DEVFLOW_WORKSPACE_ROOT="${DEVFLOW_WORKSPACE_ROOT:-$REPO_ROOT}"

GUI_DEBUG_BIN="$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app/src-tauri/target/debug/devflow-desktop"
if [ ! -f "$GUI_DEBUG_BIN" ]; then
    echo "⚡ DevFlow Desktop debug binary not found. Building debug companion app..."
    (cd "$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app" && npm run build)
    cargo build --manifest-path "$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app/src-tauri/Cargo.toml"
fi

exec "$GUI_DEBUG_BIN" "$@"
