#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export DEVFLOW_WORKSPACE_ROOT="${DEVFLOW_WORKSPACE_ROOT:-$REPO_ROOT}"

CLI_DEBUG_BIN="$DEVFLOW_WORKSPACE_ROOT/target/debug/devflow"
if [ ! -f "$CLI_DEBUG_BIN" ]; then
    echo "⚡ DevFlow CLI debug binary not found. Building debug CLI..."
    cargo build --manifest-path "$DEVFLOW_WORKSPACE_ROOT/Cargo.toml" -p devflow_cli
fi

exec "$CLI_DEBUG_BIN" "$@"
