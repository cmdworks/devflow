#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export DEVFLOW_WORKSPACE_ROOT="${DEVFLOW_WORKSPACE_ROOT:-$REPO_ROOT}"

GUI_RELEASE_BIN="$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app/src-tauri/target/release/devflow-desktop"
if [ ! -f "$GUI_RELEASE_BIN" ]; then
    echo "⚡ DevFlow Desktop release binary not found. Building release companion app..."
    (cd "$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app" && npm run build)
    cargo build --release --manifest-path "$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app/src-tauri/Cargo.toml"
fi

exec "$GUI_RELEASE_BIN" "$@"
