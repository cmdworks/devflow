# ═══════════════════════════════════════════════════════════════════════════
# DevFlow Development Environment Configuration (.envrc)
# Compatible with both 'direnv' and manual 'source .envrc'
# ═══════════════════════════════════════════════════════════════════════════

# Root workspace directory
export DEVFLOW_WORKSPACE_ROOT="$(pwd)"

# ─── 1. Android SDK & Tools ───────────────────────────────────────────────
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"

# ─── 2. Java JDK Configuration (LTS JDK 21 for Android Gradle) ────────────
if [ -d "/Library/Java/JavaVirtualMachines/jdk-21.jdk/Contents/Home" ]; then
    export JAVA_HOME="/Library/Java/JavaVirtualMachines/jdk-21.jdk/Contents/Home"
elif [ -d "/Library/Java/JavaVirtualMachines/jdk-27.jdk/Contents/Home" ]; then
    export JAVA_HOME="/Library/Java/JavaVirtualMachines/jdk-27.jdk/Contents/Home"
elif [ -x "/usr/libexec/java_home" ]; then
    export JAVA_HOME="$(/usr/libexec/java_home -v 21 2>/dev/null || /usr/libexec/java_home 2>/dev/null)"
fi

# ─── 3. Helper function for PATH additions (direnv & plain shell) ─────────
add_to_path() {
    if [ -d "$1" ]; then
        if type PATH_add >/dev/null 2>&1; then
            PATH_add "$1"
        else
            case ":$PATH:" in
                *":$1:"*) ;;
                *) export PATH="$1:$PATH" ;;
            esac
        fi
    fi
}

# ─── 4. DevFlow Local Binaries & Tauri Desktop ────────────────────────────
# Prioritize local project build targets so devflow & devflow-desktop run directly
add_to_path "$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app/src-tauri/target/release"
add_to_path "$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app/src-tauri/target/debug"
add_to_path "$DEVFLOW_WORKSPACE_ROOT/target/release"
add_to_path "$DEVFLOW_WORKSPACE_ROOT/target/debug"

# ─── 5. System Toolchains & Runtimes ──────────────────────────────────────
add_to_path "$HOME/.local/bin"
add_to_path "$HOME/.cargo/bin"
add_to_path "$HOME/.bun/bin"
add_to_path "$HOME/.nvm/versions/node/v24.19.0/bin"
add_to_path "$ANDROID_HOME/platform-tools"
add_to_path "$ANDROID_HOME/cmdline-tools/latest/bin"
add_to_path "$ANDROID_HOME/emulator"
if [ -n "$JAVA_HOME" ]; then
    add_to_path "$JAVA_HOME/bin"
fi

# ─── 6. Shell Hook & Dev Shortcuts ────────────────────────────────────────
eval "$(devflow shell hook zsh 2>/dev/null || true)"
