# ═══════════════════════════════════════════════════════════════════════════
# DevFlow Development Environment Configuration (.envrc)
# ═══════════════════════════════════════════════════════════════════════════

# 1. Root workspace directory
export DEVFLOW_WORKSPACE_ROOT="$(expand_path .)"

# 2. Add workspace bin wrappers to PATH (Highest Precedence)
# Exposes: devflow, devflow-dev, devflow-gui, devflow-gui-dev, devflow-tauri, devflow-ui
PATH_add bin

# 3. Add cargo targets
PATH_add target/debug
PATH_add clients/tauri_app/src-tauri/target/debug

# 4. Toolchain PATH additions
[ -d "$HOME/Library/Android/sdk/platform-tools" ] && PATH_add "$HOME/Library/Android/sdk/platform-tools"
[ -d "$HOME/.cargo/bin" ] && PATH_add "$HOME/.cargo/bin"
[ -d "$HOME/.bun/bin" ] && PATH_add "$HOME/.bun/bin"
[ -d "$HOME/.local/bin" ] && PATH_add "$HOME/.local/bin"

