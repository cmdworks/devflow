# ═══════════════════════════════════════════════════════════════════════════
# DevFlow Development Environment Configuration (.envrc)
# Compatible with direnv ('direnv allow') and manual 'source .envrc'
# ═══════════════════════════════════════════════════════════════════════════

# Root workspace directory
export DEVFLOW_WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" >/dev/null 2>&1 && pwd)"
[ -z "$DEVFLOW_WORKSPACE_ROOT" ] && export DEVFLOW_WORKSPACE_ROOT="$(pwd)"

# ─── 1. Optional Toolchain Fallbacks ──────────────────────────────────────
[ -d "$HOME/Library/Android/sdk" ] && export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
[ -z "$JAVA_HOME" ] && [ -x "/usr/libexec/java_home" ] && export JAVA_HOME="$(/usr/libexec/java_home 2>/dev/null)"

# ─── 2. Helper function for PATH additions ────────────────────────────────
add_to_path() {
    if [ -d "$1" ]; then
        if type PATH_add >/dev/null 2>&1; then
            PATH_add "$1"
        else
            case ":$PATH:" in
                *":$1:"*) ;;
                *) export PATH="$1:$PATH" ;;
            esac
        fi
    fi
}

# ─── 3. System Toolchains & Runtimes ──────────────────────────────────────
[ -n "$JAVA_HOME" ] && add_to_path "$JAVA_HOME/bin"
[ -n "$ANDROID_HOME" ] && add_to_path "$ANDROID_HOME/platform-tools"
add_to_path "$HOME/.nvm/versions/node/v24.19.0/bin"
add_to_path "$HOME/.bun/bin"
add_to_path "$HOME/.cargo/bin"
add_to_path "$HOME/.local/bin"

# ─── 4. Cargo Target Directories (Fallback Binary Locations) ──────────────
add_to_path "$DEVFLOW_WORKSPACE_ROOT/target/debug"
add_to_path "$DEVFLOW_WORKSPACE_ROOT/target/release"
add_to_path "$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app/src-tauri/target/debug"
add_to_path "$DEVFLOW_WORKSPACE_ROOT/clients/tauri_app/src-tauri/target/release"

# ─── 5. Workspace Bin Wrappers (Highest Precedence) ───────────────────────
# Prioritizes workspace launchers:
#   devflow, devflow-dev, devflow-gui, devflow-gui-dev, devflow-tauri, devflow-ui
add_to_path "$DEVFLOW_WORKSPACE_ROOT/bin"

# ─── 6. Dual-Binary Helpers (for interactive shells) ──────────────────────
# DevFlow CLI (crates/devflow_cli):
devflow() {
    "$DEVFLOW_WORKSPACE_ROOT/bin/devflow" "$@"
}
devflow-dev() {
    "$DEVFLOW_WORKSPACE_ROOT/bin/devflow-dev" "$@"
}

# DevFlow Desktop Companion GUI (clients/tauri_app):
devflow-gui() {
    "$DEVFLOW_WORKSPACE_ROOT/bin/devflow-gui" "$@"
}
devflow-gui-dev() {
    "$DEVFLOW_WORKSPACE_ROOT/bin/devflow-gui-dev" "$@"
}
devflow-tauri() {
    "$DEVFLOW_WORKSPACE_ROOT/bin/devflow-tauri" "$@"
}
devflow-ui() {
    "$DEVFLOW_WORKSPACE_ROOT/bin/devflow-ui" "$@"
}

# ─── 7. Shell Hook & Auto-Completions ─────────────────────────────────────
eval "$(devflow shell hook zsh 2>/dev/null || true)"
